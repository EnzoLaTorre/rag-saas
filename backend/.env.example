# --- Base de datos (PostgreSQL + pgvector) ---
# Local con Docker Compose: docker compose up db
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag

# --- Seguridad ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-de-al-menos-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS (orígenes separados por comas; vacío = ninguno) ---
# En producción: CORS_ORIGINS=https://tu-app.vercel.app
CORS_ORIGINS=

# --- Límites de la demo ---
MAX_UPLOAD_MB=10
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Cola de ingesta (opcional) ---
# Si se define, se usa un worker RQ ("rq worker ingest") en vez de BackgroundTasks.
# REDIS_URL=redis://localhost:6379/0

# --- Proveedor de IA (ollama | cloud) ---
# "ollama" = gratis y local. "cloud" = API externa (Gemini por defecto).
AI_PROVIDER=ollama

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBEDDING_DIM=768

# Nube (API compatible con OpenAI; por defecto Google Gemini, tier gratuito)
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
CLOUD_API_KEY=tu-clave-de-gemini
CLOUD_CHAT_MODEL=gemini-3.8-flash
CLOUD_EMBED_MODEL=gemini-embedding-001
CLOUD_EMBEDDING_DIM=768

# (opcional) OpenAI puro, si no usas Gemini
# OPENAI_API_KEY=sk-...
